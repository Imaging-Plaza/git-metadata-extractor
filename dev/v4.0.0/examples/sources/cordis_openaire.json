ace.openaire.eu/oaf https://www.openaire.eu/schema/1.0/oaf-1.0.xsd", "oaf:project" : { "collectedfrom" : { "@name" : "CORDA - COmmon Research DAta Warehouse - Horizon Europe", "@id" : "openaire____::3f264f93cf3b0cfc4ede188a6300455c" }, "originalId" : { "$" : "corda_____he::101129744" }, "pid" : { "@classid" : "doi", "@classname" : "Digital Object Identifier", "@schemeid" : "dnet:pid_types", "@schemename" : "dnet:pid_types", "@inferred" : false, "@provenanceaction" : "sysimport:crosswalk:entityregistry", "@trust" : "0.900", "$" : "10.3030/101129744" }, "measure" : [ { "@id" : "numOfInfluentialResults", "@score" : "70" }, { "@id" : "numOfPopularResults", "@score" : "70" }, { "@id" : "totalImpulse", "@score" : "74" }, { "@id" : "totalCitationCount", "@score" : "91" }, { "@id" : "totalFilteredCitationCount", "@score" : "80" }, { "@id" : "downloads", "@count" : "85", "@datasource" : "count" }, { "@id" : "views", "@count" : "92", "@datasource" : "count" } ], "code" : { "$" : "101129744" }, "acronym" : { "$" : "EVERSE" }, "title" : { "$" : "European Virtual Institute for Research Software Excellence" }, "startdate" : { "$" : "2024-03-01" }, "enddate" : { "$" : "2027-02-28" }, "callidentifier" : { "$" : "HORIZON-INFRA-2023-EOSC-01" }, "duration" : { "$" : "0" }, "ecarticle29_3" : { "$" : true }, "subject" : [ { "@classid" : "ec:hetopics", "@classname" : "Horizon Europe Topics", "@schemeid" : "dnet:subject_classification_typologies", "@schemename" : "dnet:subject_classification_typologies", "@inferred" : false, "@provenanceaction" : "sysimport:crosswalk:entityregistry", "@trust" : "0.900", "$" : "Development of community-based approaches for ensuring and improving the quality of scientific software and code" }, { "@classid" : "ec:hetopics", "@classname" : "Horizon Europe Topics", "@schemeid" : "dnet:subject_classification_typologies", "@schemename" : "dnet:subject_classification_typologies", "@inferred" : false, "@provenanceaction" : "sysimport:crosswalk:entityregistry", "@trust" : "0.900", "$" : "Development of community-based approaches for ensuring and improving the quality of scientific software and code" } ], "contracttype" : { "@classid" : "HORIZON-RIA", "@classname" : "HORIZON-RIA", "@schemeid" : "ec:hetoas", "@schemename" : "Horizon Europe - Type of Actions" }, "oamandatepublications" : { "$" : true }, "ecsc39" : { "$" : false }, "summary" : { "$" : "The EVERSE project aims to create a framework for research software and code excellence, collaboratively designed and championed by the research communities across five EOSC Science Clusters and national Research Software Expertise Centres, in pursuit of building a European network of Research Software Quality and setting the foundations of a future Virtual Institute for Research Software Excellence.\n\n            This framework for research software excellence will incorporate aspects involving community curation, quality assessment, and best practices for research software. This collective knowledge will be captured in the Research Software Quality toolkit (RSQkit), a knowledge base to gather and curate expertise that will contribute to high-quality software and code across different disciplines.\n\n            By embedding the RSQkit and services into the EOSC Science Clusters, EVERSE will demonstrate improvements in the quality of research software and maximise its reuse, leading to standardised software development practices and sustainable research software. Furthermore, we will drive recognition of software and support career progress for developers, from researchers who code to RSEs, raising their capacity to guarantee software quality.\n\n            The European network for Research Software Quality aims to cross-fertilise different research domains, act as a lobbying organisation, and raise awareness of software as a key enabler in research, with the overall ambition to accelerate research and innovation through improving the quality of research software and code.\n\n            EVERSE ultimate ambition is to contribute towards a cultural change where research software is recognized as a first-class citizen of the scientific process and the people that contribute to it are credited for their efforts." }, "currency" : { "$" : "EUR" }, "totalcost" : { "$" : 6789470.0 }, "fundedamount" : { "$" : 6789470.0 }, "fundingtree" : { "funder" : { "id" : { "$" : "ec__________::EC" }, "shortname" : { "$" : "EC" }, "name" : { "$" : "European Commission" }, "jurisdiction" : { "$" : "EU" } }, "funding_level_1" : { "id" : { "$" : "ec__________::EC::HE::HORIZON-RIA" }, "description" : { "$" : "HORIZON  Research and Innovation Actions" }, "name" : { "$" : "HORIZON-RIA" }, "class" : { "$" : "ec:hetoas" }, "parent" : { "funding_level_0" : { "id" : { "$" : "ec__________::EC::HE" }, "name" : { "$" : "HE" }, "description" : { "$" : "Horizon Europe Framework Programme" }, "parent" : null, "class" : { "$" : "ec:hefundings" } } } } }, "context" : { "@id" : "lifewatch-eric", "@label" : "LifeWatch ERIC", "@type" : "ri" }, "datainfo" : { "inferred" : { "$" : false }, "deletedbyinference" : { "$" : false }, "trust" : { "$" : "0.900" }, "inferenceprovenance" : { "$" : "null" }, "provenanceaction" : { "@classid" : "sysimport:crosswalk:entityregistry", "@classname" : "Harvested", "@schemeid" : "dnet:provenanceActions", "@schemename" : "dnet:provenanceActions" } }, "rels" : { "rel" : [ { "@inferred" : false, "@trust" : "0.900", "@inferenceprovenance" : "", "@provenanceaction" : "sysimport:crosswalk:entityregistry", "to" : { "@class" : "hasParticipant", "@scheme" : "dnet:project_organization_relations", "@type" : "organization", "$" : "openorgs____::3b232bdd96cea022f1baddd5efa84b00" }, "legalname" : { "$" : "Centre for Research and Technology Hellas" }, "country" : { "@classid" : "GR", "@classname" : "Greece", "@schemeid" : "dnet:countries", "@schemename" : "dnet:countries" }, "websiteurl" : { "$" : "http://www.certh.gr/root.en.aspx" }, "legalshortname" : { "$" : "C