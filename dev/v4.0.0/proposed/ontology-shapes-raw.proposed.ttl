@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix pulse:  <https://open-pulse.epfl.ch/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

# ---------------------------------------------------------
# RAW SHAPES
#
# Validates data as extractors actually emit it: one PlatformProfile
# per source, a provisional Person/Organization with no ORCID/ROR
# resolved yet, plus every platform-specific field needed for full
# field-parity with GitHub/Hugging Face/Zenodo/ORCID.
#
# This file is standalone — it does NOT extend ontology-shapes-canonical.ttl's
# canonical PersonShape/OrganizationShape/etc. sh:targetClass applies
# to every node of that class across the whole loaded shapes graph,
# so a looser raw shape cannot coexist with the closed canonical one
# in the same graph. Load this file together with the shared
# ontology-definitions-canonical.ttl + ontology-enumerations-canonical.ttl
# (for the base classes/enums it reuses) and this repo's own
# ontology-definitions-raw.ttl + ontology-enumerations-raw.ttl — never
# together with ontology-shapes-canonical.ttl.
# ---------------------------------------------------------

# ---------------------------------------------------------
# NODE SHAPES — entities needing raw-specific identity or fields
# ---------------------------------------------------------

pulse:RawPersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:closed false ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pulse:orcidIdentifier ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$" ;
        sh:maxCount 1 ;
        sh:name "ORCID"
    ] ;
    sh:property [
        sh:path pulse:hasProfile ;
        sh:class pulse:PlatformProfile ;
        sh:name "Has Profile" ;
        sh:description "Platform-scoped identities held by this provisional person. Extraction never resolves canonical identity — this is the anchor."
    ] ;
    sh:property [ sh:path pulse:hasContribution ; sh:class pulse:Contribution ; sh:name "Has Contribution" ] ;
    sh:property [ sh:path org:hasMembership ; sh:class org:Membership ; sh:name "hasMembership" ] ;
    sh:property [ sh:path pulse:owns ; sh:class schema:SoftwareSourceCode ; sh:name "Owns Repository" ] ;
    sh:property [ sh:path pulse:hasAuthoredArticle ; sh:class schema:ScholarlyArticle ; sh:name "Has Authored Article" ] ;
    sh:property [ sh:path pulse:hasFunding ; sh:class pulse:Funding ; sh:name "Has Funding" ] ;
    sh:property [
        sh:path pulse:ownsCollection ;
        sh:class pulse:Collection ;
        sh:name "Owns Collection"
    ] ;
    sh:property [ sh:path pulse:biography ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Biography" ] ;
    sh:property [ sh:path pulse:keyword ; sh:datatype xsd:string ; sh:name "Keyword" ] ;
    sh:property [ sh:path pulse:country ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Country" ] ;
    sh:property [
        sh:path pulse:hasExternalIdentifier ;
        sh:class pulse:ExternalIdentifier ;
        sh:name "Has External Identifier"
    ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:name "Part Of Run"
    ] .

pulse:RawOrganizationShape
    a sh:NodeShape ;
    sh:targetClass org:Organization ;
    sh:closed false ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pulse:ror ;
        sh:datatype xsd:string ;
        sh:pattern "^https://ror\\.org/[0-9a-z]{9}$" ;
        sh:maxCount 1 ;
        sh:name "ROR"
    ] ;
    sh:property [
        sh:path pulse:hasOrganizationProfile ;
        sh:class pulse:OrganizationProfile ;
        sh:name "Has Organization Profile" ;
        sh:description "Platform-scoped identities held by this provisional organization, if any were discovered on a platform."
    ] ;
    sh:property [
        sh:path pulse:organizationType ;
        sh:class pulse:OrganizationTypeEnumeration ;
        sh:name "Organization Type"
    ] ;
    sh:property [ sh:path org:hasUnit ; sh:class org:Organization ; sh:name "Has Unit" ] ;
    sh:property [ sh:path org:unitOf ; sh:class org:Organization ; sh:name "Unit Of" ] ;
    sh:property [ sh:path pulse:owns ; sh:class schema:SoftwareSourceCode ; sh:name "Owns Repositories" ] ;
    sh:property [ sh:path schema:member ; sh:class schema:Person ; sh:name "Members" ] ;
    sh:property [ sh:path pulse:ownsCollection ; sh:class pulse:Collection ; sh:name "Owns Collection" ] ;
    sh:property [
        sh:path pulse:hasExternalIdentifier ;
        sh:class pulse:ExternalIdentifier ;
        sh:name "Has External Identifier"
    ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:name "Part Of Run"
    ] .

pulse:RawPlatformProfileShape
    a sh:NodeShape ;
    sh:targetClass pulse:PlatformProfile ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path pulse:platform ;
        sh:class pulse:PlatformEnumeration ;
        sh:maxCount 1 ;
        sh:name "Platform"
    ] ;
    sh:property [ sh:path pulse:profileOf ; sh:class schema:Person ; sh:maxCount 1 ; sh:name "Profile Of" ] ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:name "Display Name" ] ;
    sh:property [
        sh:path schema:email ;
        sh:nodeKind sh:Literal ;
        sh:pattern "^[\\w\\-\\.\\+]+@([\\w-]+\\.)+[\\w-]{2,}$" ;
        sh:name "Email"
    ] ;
    sh:property [ sh:path schema:url ; sh:nodeKind sh:IRI ; sh:name "URL" ] ;
    sh:property [ sh:path pulse:platformUsername ; sh:datatype xsd:string ; sh:name "Platform Username" ] ;
    sh:property [ sh:path pulse:platformInternalId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Internal ID" ] ;
    sh:property [ sh:path pulse:platformNodeId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Node ID" ] ;
    sh:property [ sh:path pulse:biography ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Bio" ] ;
    sh:property [ sh:path schema:image ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "Image" ] ;
    sh:property [ sh:path pulse:location ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Location" ] ;
    sh:property [ sh:path pulse:socialLink ; sh:nodeKind sh:IRI ; sh:name "Social Link" ] ;
    sh:property [ sh:path pulse:followerCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Followers" ] ;
    sh:property [ sh:path pulse:followingCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Following" ] ;
    sh:property [ sh:path pulse:company ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Company" ] ;
    sh:property [ sh:path pulse:publicRepositoryCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Public Repositories" ] ;
    sh:property [ sh:path pulse:publicGistCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Public Gists" ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Created Date" ] ;
    sh:property [ sh:path schema:dateModified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Updated Date" ] .

pulse:RawOrganizationProfileShape
    a sh:NodeShape ;
    sh:targetClass pulse:OrganizationProfile ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path pulse:platform ;
        sh:class pulse:PlatformEnumeration ;
        sh:maxCount 1 ;
        sh:name "Platform"
    ] ;
    sh:property [ sh:path pulse:organizationProfileOf ; sh:class org:Organization ; sh:maxCount 1 ; sh:name "Organization Profile Of" ] ;
    sh:property [ sh:path pulse:organizationHandle ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Organization Handle" ] ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:name "Display Name" ] ;
    sh:property [ sh:path schema:url ; sh:nodeKind sh:IRI ; sh:name "URL" ] ;
    sh:property [ sh:path pulse:platformInternalId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Internal ID" ] ;
    sh:property [ sh:path schema:description ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Description" ] ;
    sh:property [ sh:path pulse:location ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Location" ] ;
    sh:property [ sh:path pulse:followerCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Followers" ] ;
    sh:property [ sh:path schema:dateModified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Updated Date" ] .

pulse:RawRepositoryShape
    a sh:NodeShape ;
    sh:targetClass schema:SoftwareSourceCode ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pulse:repositoryType ; sh:class pulse:RepositoryTypeEnumeration ; sh:name "Repository Type" ] ;
    sh:property [ sh:path pulse:discipline ; sh:class pulse:DisciplineEnumeration ; sh:name "Discipline" ] ;
    sh:property [ sh:path pulse:platformInternalId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Internal ID" ] ;
    sh:property [ sh:path pulse:platformNodeId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Node ID" ] ;
    sh:property [ sh:path schema:author ; sh:class schema:Person ; sh:name "Author" ] ;
    sh:property [
        sh:path pulse:platform ;
        sh:class pulse:PlatformEnumeration ;
        sh:maxCount 1 ;
        sh:name "Platform"
    ] ;
    sh:property [ sh:path pulse:repositoryStars ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Stars" ] ;
    sh:property [ sh:path pulse:repositoryForks ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Forks" ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:name "Creation Date" ] ;
    sh:property [
        sh:path pulse:repositoryHandle ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z0-9\\-_.]+(/[a-zA-Z0-9\\-_.]+)+$" ;
        sh:name "Repository Handle"
    ] ;
    sh:property [ sh:path schema:license ; sh:nodeKind sh:IRI ; sh:name "License" ] ;
    sh:property [ sh:path schema:citation ; sh:nodeKind sh:IRI ; sh:name "Citation" ] ;
    sh:property [ sh:path schema:programmingLanguage ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pulse:ownedBy ;
        sh:or ( [ sh:class schema:Person ] [ sh:class org:Organization ] ) ;
        sh:maxCount 1 ;
        sh:name "Owned By"
    ] ;
    sh:property [ sh:path pulse:isForkOf ; sh:class schema:SoftwareSourceCode ; sh:maxCount 1 ; sh:name "Is Fork Of" ] ;
    sh:property pulse:DescriptionShape ;
    sh:property [ sh:path pulse:tag ; sh:datatype xsd:string ; sh:name "Tag" ] ;
    sh:property [ sh:path schema:url ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "Homepage" ] ;
    sh:property [ sh:path pulse:visibility ; sh:class pulse:VisibilityEnumeration ; sh:maxCount 1 ; sh:name "Visibility" ] ;
    sh:property [ sh:path pulse:archived ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Archived" ] ;
    sh:property [ sh:path pulse:isTemplate ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Template Repository" ] ;
    sh:property [ sh:path pulse:defaultBranch ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Default Branch" ] ;
    sh:property [ sh:path pulse:watcherCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Watchers" ] ;
    sh:property [ sh:path pulse:openIssueCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Open Issues" ] ;
    sh:property [ sh:path pulse:hasDiscussions ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Discussions" ] ;
    sh:property [ sh:path pulse:hasWiki ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Wiki Enabled" ] ;
    sh:property [ sh:path pulse:hasPages ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Pages Enabled" ] ;
    sh:property [ sh:path pulse:releaseCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Releases" ] ;
    sh:property [ sh:path pulse:gitTagCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Tags" ] ;
    sh:property [ sh:path pulse:branchCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Branches" ] ;
    sh:property [ sh:path pulse:readme ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "README" ] ;
    sh:property [ sh:path pulse:fundingConfig ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "FUNDING.yml" ] ;
    sh:property [ sh:path pulse:publicCodeManifest ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "publiccode.yml" ] ;
    sh:property [ sh:path pulse:securityPolicy ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "SECURITY.md" ] ;
    sh:property [ sh:path pulse:codeOfConduct ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "CODE_OF_CONDUCT.md" ] ;
    sh:property [ sh:path pulse:dependencyCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Dependencies" ] ;
    sh:property [ sh:path pulse:dependentCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Dependents" ] ;
    sh:property [ sh:path pulse:dependsOn ; sh:class schema:SoftwareSourceCode ; sh:name "Depends On" ] ;
    sh:property [ sh:path pulse:dependencyOf ; sh:class schema:SoftwareSourceCode ; sh:name "Dependency Of" ] ;
    sh:property [ sh:path pulse:pushedDate ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Pushed Date" ] ;
    sh:property [ sh:path schema:dateModified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Updated Date" ] ;
    sh:property [ sh:path pulse:likeCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Likes" ] ;
    sh:property [ sh:path pulse:pipelineTag ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Pipeline Tag" ] ;
    sh:property [ sh:path pulse:task ; sh:datatype xsd:string ; sh:name "Task" ] ;
    sh:property [ sh:path pulse:library ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Library" ] ;
    sh:property [ sh:path pulse:framework ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Framework" ] ;
    sh:property [ sh:path pulse:language ; sh:datatype xsd:string ; sh:name "Language" ] ;
    sh:property [ sh:path pulse:downloadCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Downloads" ] ;
    sh:property [ sh:path pulse:gated ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:name "Gated" ] ;
    sh:property [ sh:path pulse:modality ; sh:class pulse:ModalityEnumeration ; sh:name "Modality" ] ;
    sh:property [ sh:path pulse:datasetSplit ; sh:datatype xsd:string ; sh:name "Split" ] ;
    sh:property [ sh:path pulse:configuration ; sh:datatype xsd:string ; sh:name "Configuration" ] ;
    sh:property [ sh:path pulse:sdk ; sh:class pulse:SpaceSdkEnumeration ; sh:maxCount 1 ; sh:name "SDK" ] ;
    sh:property [ sh:path pulse:hardware ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Hardware" ] ;
    sh:property [ sh:path pulse:runtimeStatus ; sh:class pulse:SpaceRuntimeStatusEnumeration ; sh:maxCount 1 ; sh:name "Runtime Status" ] ;
    sh:property [ sh:path pulse:relatedRepository ; sh:class schema:SoftwareSourceCode ; sh:name "Related Repository" ] ;
    sh:property [ sh:path pulse:fileCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Files" ] ;
    sh:property [ sh:path pulse:lfsObjectCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "LFS Objects" ] ;
    sh:property [ sh:path pulse:xetObjectCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Xet Objects" ] ;
    sh:property [ sh:path pulse:externalReference ; sh:nodeKind sh:IRI ; sh:name "External Reference" ] ;
    sh:property [
        sh:path pulse:hasExternalIdentifier ;
        sh:class pulse:ExternalIdentifier ;
        sh:name "Has External Identifier"
    ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:name "Part Of Run"
    ] .

pulse:DescriptionShape
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

pulse:RawArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pulse:doi ;
        sh:datatype xsd:string ;
        sh:pattern "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$" ;
        sh:name "DOI"
    ] ;
    sh:property [ sh:path schema:author ; sh:class schema:Person ; sh:name "Author" ] ;
    sh:property [ sh:path schema:sourceOrganization ; sh:class org:Organization ; sh:name "Source Organization" ] ;
    sh:property [ sh:path pulse:hasDeposit ; sh:class pulse:Deposit ; sh:name "Has Deposit" ] ;
    sh:property [
        sh:path pulse:conceptDoi ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$" ;
        sh:name "Concept DOI"
    ] ;
    sh:property [ sh:path pulse:version ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Version" ] ;
    sh:property pulse:DescriptionShape ;
    sh:property [ sh:path pulse:keyword ; sh:datatype xsd:string ; sh:name "Keyword" ] ;
    sh:property [ sh:path pulse:discipline ; sh:class pulse:DisciplineEnumeration ; sh:name "Discipline" ] ;
    sh:property [ sh:path schema:license ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "License" ] ;
    sh:property [ sh:path pulse:contributor ; sh:class schema:Person ; sh:name "Contributor" ] ;
    sh:property [ sh:path schema:funder ; sh:class org:Organization ; sh:name "Grant" ] ;
    sh:property [
        sh:path pulse:hasExternalIdentifier ;
        sh:class pulse:ExternalIdentifier ;
        sh:name "Has External Identifier"
    ] ;
    sh:property [ sh:path pulse:references ; sh:class schema:ScholarlyArticle ; sh:name "References" ] ;
    sh:property [ sh:path pulse:fileCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Files" ] ;
    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Created Date" ] ;
    sh:property [ sh:path schema:dateModified ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Updated Date" ] ;
    sh:property [ sh:path pulse:memberOfCommunity ; sh:class pulse:Community ; sh:name "Community" ] ;
    sh:property [
        sh:path pulse:relatedRepository ;
        sh:class schema:SoftwareSourceCode ;
        sh:name "Related Repository"
    ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:name "Part Of Run"
    ] .

pulse:RawMembershipShape
    a sh:NodeShape ;
    sh:targetClass org:Membership ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path org:organization ;
        sh:class org:Organization ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "Organization"
    ] ;
    sh:property [ sh:path org:role ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Role" ] ;
    sh:property [ sh:path pulse:membershipType ; sh:class pulse:MembershipTypeEnumeration ; sh:maxCount 1 ; sh:name "Membership Type" ] ;
    sh:property [ sh:path pulse:department ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Department" ] ;
    sh:property [ sh:path pulse:qualification ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Qualification" ] ;
    sh:property [ sh:path time:hasBeginning ; sh:datatype xsd:date ; sh:name "Start Date" ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:name "End Date" ] .

# ---------------------------------------------------------
# NEW NODE SHAPES — classes with no canonical counterpart
# ---------------------------------------------------------

pulse:CollectionShape
    a sh:NodeShape ;
    sh:targetClass pulse:Collection ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pulse:platformInternalId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Internal ID" ] ;
    sh:property [ sh:path pulse:platform ; sh:class pulse:PlatformEnumeration ; sh:maxCount 1 ; sh:name "Platform" ] ;
    sh:property [
        sh:path pulse:collectionOwnedBy ;
        sh:or ( [ sh:class schema:Person ] [ sh:class org:Organization ] ) ;
        sh:maxCount 1 ;
        sh:name "Owner"
    ] ;
    sh:property [
        sh:path pulse:collectionIncludes ;
        sh:or ( [ sh:class schema:SoftwareSourceCode ] [ sh:class schema:ScholarlyArticle ] ) ;
        sh:name "Includes"
    ] .

pulse:CommunityShape
    a sh:NodeShape ;
    sh:targetClass pulse:Community ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pulse:platformInternalId ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:name "Platform Internal ID" ] ;
    sh:property pulse:DescriptionShape ;
    sh:property [ sh:path schema:url ; sh:nodeKind sh:IRI ; sh:name "URL" ] ;
    sh:property [ sh:path schema:image ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:name "Logo" ] ;
    sh:property [ sh:path pulse:curator ; sh:class schema:Person ; sh:name "Curator" ] ;
    sh:property [ sh:path schema:member ; sh:class schema:Person ; sh:name "Member" ] .

pulse:FundingShape
    a sh:NodeShape ;
    sh:targetClass pulse:Funding ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:funder ; sh:class org:Organization ; sh:maxCount 1 ; sh:name "Funder" ] ;
    sh:property [ sh:path pulse:hasExternalIdentifier ; sh:class pulse:ExternalIdentifier ; sh:name "Grant Identifier" ] ;
    sh:property [ sh:path time:hasBeginning ; sh:datatype xsd:date ; sh:name "Start Date" ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:name "End Date" ] .

pulse:ExternalIdentifierShape
    a sh:NodeShape ;
    sh:targetClass pulse:ExternalIdentifier ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path pulse:identifierScheme ;
        sh:class pulse:IdentifierSchemeEnumeration ;
        sh:maxCount 1 ;
        sh:name "Scheme"
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Value"
    ] .

# ---------------------------------------------------------
# EXTRACTION OUTPUT — the self-describing header a substrate graph
# carries about itself (same IRI as the graph name). Lives inside the
# raw graph, so it's shaped here, not in the provenance ontology.
# ---------------------------------------------------------

pulse:ExtractionOutputShape
    a sh:NodeShape ;
    sh:targetClass pulse:ExtractionOutput ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:class pulse:ExtractionRun ;
        sh:maxCount 1 ;
        sh:name "Was Generated By"
    ] ;
    sh:property [
        sh:path pulse:platform ;
        sh:class pulse:PlatformEnumeration ;
        sh:maxCount 1 ;
        sh:name "Platform"
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Generated At"
    ] .


# ---------------------------------------------------------
# ASK #14 — pulse:partOfRun on every raw node shape.
#
# Added as standalone statements rather than edited into the blocks
# above, so the diff stays minimal and their formatting survives.
# Without these, the nodes that exist to hold one platform's view of
# an entity cannot say which ExtractionOutput produced them — which is
# the backbone of the provenance profile.
# ---------------------------------------------------------

pulse:RawPlatformProfileShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:RawOrganizationProfileShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:RawMembershipShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:CollectionShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:CommunityShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:FundingShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .
pulse:ExternalIdentifierShape sh:property [
    sh:path pulse:partOfRun ;
    sh:class pulse:ExtractionOutput ;
    sh:name "Part Of Run"
] .


# ---------------------------------------------------------
# NEW SHAPES — from ontology-shapes-raw.additions.ttl
# ---------------------------------------------------------


# ---------------------------------------------------------
# RAW CONTRIBUTION — currently absent from this profile
# ---------------------------------------------------------

pulse:RawContributionShape
    a sh:NodeShape ;
    sh:targetClass pulse:Contribution ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path pulse:contributionTo ;
        sh:class schema:SoftwareSourceCode ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "Contribution To" ;
        sh:description "The repository these contributions were made to."
    ] ;
    sh:property [
        sh:path schema:author ;
        sh:class schema:Person ;
        sh:maxCount 1 ;
        sh:name "Contributor" ;
        sh:description "The provisional person these contributions are attributed to. Provisional at extraction time — the canonical layer decides who that really is."
    ] ;
    sh:property [
        sh:path pulse:hasGitIdentity ;
        sh:class pulse:GitIdentity ;
        sh:name "Has Git Identity" ;
        sh:description "Every (author name, author email) pair observed for this contributor in this repository's history. Deliberately unbounded: one person routinely commits under several, and which ones they are is the evidence identity reconciliation runs on."
    ] ;
    sh:property [ sh:path pulse:contributionCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Contribution Count" ] ;
    sh:property [ sh:path pulse:firstContributionDate ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "First Contribution Date" ] ;
    sh:property [ sh:path pulse:lastContributionDate ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Last Contribution Date" ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:maxCount 1 ;
        sh:name "Part Of Run"
    ] .


# ---------------------------------------------------------
# GIT IDENTITY — one observed (name, email) pair
# ---------------------------------------------------------

pulse:RawGitIdentityShape
    a sh:NodeShape ;
    sh:targetClass pulse:GitIdentity ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [
        sh:path pulse:gitAuthorName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Git Author Name" ;
        sh:description "The author name exactly as it appears in the commit, unmodified. maxCount 1 is correct HERE — this node is a single observed pair; multiplicity lives on pulse:hasGitIdentity."
    ] ;
    sh:property [
        sh:path pulse:gitAuthorEmailHash ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Git Author Email Hash" ;
        sh:description "One-way hash of the address's local part. Stable across runs and repositories, so one person's commits under one address collapse wherever they appear."
    ] ;
    sh:property [
        sh:path pulse:gitAuthorEmailDomain ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Git Author Email Domain" ;
        sh:description "The domain part alone. Carries the institutional affiliation signal with no personal identifier."
    ] ;
    sh:property [
        sh:path pulse:gitAuthorEmail ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Git Author Email" ;
        sh:description "The full address. git-metadata-extractor never populates this; retained for extractors with a different disclosure policy."
    ] ;
    sh:property [
        sh:path pulse:gitIdentityRole ;
        sh:datatype xsd:string ;
        sh:name "Role" ;
        sh:description "Whether this identity appeared as the commit author, the committer, or a Co-authored-by trailer. Multi-valued: the same pair is often several of these. Rebases and web-UI edits set a different committer, and trailer identities never appear as the author at all — so pair-programmed work is invisible if only authors are read."
    ] ;
    sh:property [ sh:path pulse:contributionCount ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:name "Commit Count" ] ;
    sh:property [ sh:path pulse:firstContributionDate ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "First Commit" ] ;
    sh:property [ sh:path pulse:lastContributionDate ; sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:name "Last Commit" ] ;
    sh:property [
        sh:path pulse:isBotIdentity ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "Is Bot" ;
        sh:description "Whether this is an automation account (dependabot[bot], github-actions[bot], renovate[bot], ...). Bots are commit authors and are not people; unflagged they inflate contributor counts and cause Person nodes to be minted for machines."
    ] ;
    sh:property [
        sh:path pulse:isPseudonymousEmail ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "Is Pseudonymous Email" ;
        sh:description "Whether the address is a platform-issued privacy address (12345+login@users.noreply.github.com). It carries no affiliation signal and is not a way to reach anyone."
    ] ;
    sh:property [
        sh:path pulse:mailmapApplied ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:name "Mailmap Applied" ;
        sh:description "Whether this identity was normalised through the repository's .mailmap. A mailmap entry is the maintainer's own assertion that two identities are one person — stronger evidence than anything an extractor infers."
    ] ;
    sh:property [ sh:path pulse:gitIdentityOf ; sh:name "Identity Of" ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:maxCount 1 ;
        sh:name "Part Of Run"
    ] .


# ---------------------------------------------------------
# RAW PROJECT — canonical has pulse:ProjectShape, raw has nothing
#
# ontology-shapes-raw.ttl contains zero occurrences of "project", while
# canonical defines schema:Project and a closed pulse:ProjectShape. So an
# extractor cannot legally emit a project, even though we hold project-shaped
# data: SNSF grants (grant number, title, state, dates — with IRIs we already
# mint), ORCID /fundings, CORDIS EU projects, Infoscience's crispj schema.
#
# Mirrors the canonical shape but extraction-shaped: open, run-stamped, and
# multi-valued where two funders describe the same project differently.
# ---------------------------------------------------------

pulse:RawProjectShape
    a sh:NodeShape ;
    sh:targetClass schema:Project ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;
    sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:name "Title" ] ;
    sh:property [ sh:path schema:description ; sh:datatype xsd:string ; sh:name "Description" ] ;
    sh:property [ sh:path schema:url ; sh:nodeKind sh:IRI ; sh:name "URL" ] ;
    sh:property [
        sh:path pulse:awardNumber ;
        sh:datatype xsd:string ;
        sh:name "Award Number" ;
        sh:description "The funder's identifier — an SNSF grant number, an EU grant agreement number. Multi-valued: a project co-funded by two bodies has two."
    ] ;
    sh:property [
        sh:path pulse:projectOutput ;
        sh:name "Project Output" ;
        sh:description "A repository or article produced by the project. Left untyped here, unlike canonical's sh:or, because at extraction time an output is often only a DOI or a URL whose kind is not yet resolved."
    ] ;
    sh:property [ sh:path schema:member ; sh:class schema:Person ; sh:name "Member" ] ;
    sh:property [ sh:path schema:sourceOrganization ; sh:class org:Organization ; sh:name "Host Organization" ] ;
    sh:property [ sh:path schema:funder ; sh:class org:Organization ; sh:name "Funder" ] ;
    sh:property [ sh:path pulse:fundedBy ; sh:class pulse:Funding ; sh:name "Funded By" ] ;
    sh:property [ sh:path time:hasBeginning ; sh:datatype xsd:date ; sh:name "Start Date" ] ;
    sh:property [ sh:path time:hasEnd ; sh:datatype xsd:date ; sh:name "End Date" ] ;
    sh:property [
        sh:path pulse:partOfRun ;
        sh:class pulse:ExtractionOutput ;
        sh:maxCount 1 ;
        sh:name "Part Of Run"
    ] .

# Note the two deliberate departures from canonical ProjectShape, both for the
# reasons in §18 of ontology.ttl: sh:closed false, because a funder API will
# always have a field we have not modelled; and no sh:maxCount on the dates or
# the title, because SNSF and CORDIS can describe one project differently and
# raw is not where that gets resolved.


# ---------------------------------------------------------
# ALSO NEEDED, in ontology-shapes-canonical.ttl
#
# The canonical ContributionShape is where the cap actually bites once raw
# output is unified. Either mirror the link:
#
#   sh:property [ sh:path pulse:hasGitIdentity ; sh:class pulse:GitIdentity ] ;
#
# and drop the two gitAuthorName / gitAuthorEmail property shapes, or keep
# them and remove their sh:maxCount 1. Canonical PersonShape would take the
# same pulse:hasGitIdentity property if you would rather hang identities off
# the person than off the contribution — we have no preference, as long as
# more than one survives.
# ---------------------------------------------------------
