# Environment variables for git-metadata-extractor
# Copy this file to .env and fill in your actual values

# Optional: devcontainer SSH — applied on each container start (see .devcontainer/set-vscode-password.sh).
# Do not commit real values; keep only in local .env (gitignored).
# VSCODE_PASSWORD=

# Dev container: if PyPI fails with DNS errors, set resolvers in `.devcontainer/.env`
# (see `.devcontainer/.env.example`).

# EPFL RCP Token for inference endpoint
RCP_TOKEN=your-rcp-token-here

# OpenAI API Key (if using OpenAI provider)
OPENAI_API_KEY=your-openai-key-here

# OpenRouter API Key (if using OpenRouter provider)
OPENROUTER_API_KEY=your-openrouter-key-here

# GitHub API token (required for v2 preflight)
GITHUB_TOKEN=your-github-token-here

# V2 extraction pipeline configuration
V2_ALLOW_SYNTHETIC_FALLBACKS=false

# V2 provider response cache (GitHub users/orgs, ORCID, Infoscience, ROR).
# Single TTL applied to every cached entry. Default: 30 days.
V2_PROVIDER_CACHE_PATH=.cache/v2/providers.db
V2_PROVIDER_CACHE_TTL_DAYS=30
V2_PROVIDER_CACHE_ENABLED=true

# Pipeline-level response cache (the outer /extract → V2ExtractResponse cache).
# Set to `false` to force every /extract call to re-run the full pipeline while
# keeping every sub-cache (provider responses, agent verdicts, Selenium fetches,
# link-veracity verdicts) active. Useful when you want to verify the sub-caches
# are doing their job. Default: true.
V2_PIPELINE_CACHE_ENABLED=true

# Per-request log of every external-service query the LLM agents try
# (Infoscience, ORCID, ROR, GitHub, DuckDuckGo, Selenium, etc.).
# Each /extract call writes one JSON file `<run_id>.json` here. Default:
# `logs/v2_queries/` (relative to the server's working directory).
V2_QUERY_LOG_DIR=logs/v2_queries
